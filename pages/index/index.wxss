/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
}

/* 统计卡片 */
.stat-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #1f2329;
}
.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa3af;
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef0f2;
}

/* 过滤 Tab */
.filter-bar {
  display: flex;
  margin: 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}
.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  padding: 16rpx 0;
  border-radius: 12rpx;
  transition: background 0.2s;
}
.filter-tab--active {
  background: #2f6fed;
  color: #ffffff;
  font-weight: 500;
}

/* 列表 */
.list {}
.todo-card {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}
.check {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #c8cdd4;
  margin-right: 24rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check--done {
  background: #2f6fed;
  border-color: #2f6fed;
}
.check-mark {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
}
.todo-body {
  flex: 1;
  min-width: 0;
}
.todo-title {
  font-size: 30rpx;
  color: #1f2329;
  word-break: break-all;
}
.todo-title--done {
  color: #9aa3af;
  text-decoration: line-through;
}
.todo-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}
.due {
  font-size: 24rpx;
  color: #6b7280;
}
.due--warn {
  color: #e5484d;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx dashed #c8cdd4;
  position: relative;
}
.empty-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 48rpx;
  height: 2rpx;
  background: #c8cdd4;
  transform: translate(-50%, -50%);
}
.empty-title {
  margin-top: 32rpx;
  font-size: 32rpx;
  color: #6b7280;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9aa3af;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2f6fed;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: 0 8rpx 24rpx rgba(47, 111, 237, 0.36);
  z-index: 90;
}

/* 快速新增半屏模态框（Bottom Sheet） */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(4px);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.26s cubic-bezier(0.16, 1, 0.3, 1);
}
.drawer-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.12);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  box-sizing: border-box;
  padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow: hidden; /* 坚决无滚动 */
}
.drawer--show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.drawer-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  letter-spacing: 0.5rpx;
}
.drawer-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #9aa3af;
  border-radius: 50%;
  background: #f5f6f8;
  transition: background 0.15s;
}

.drawer-body {
  display: flex;
  flex-direction: column;
}
.drawer-input {
  font-size: 34rpx;
  font-weight: 500;
  color: #1f2329;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-bottom: 2rpx solid #f0f1f3;
}
.drawer-placeholder {
  color: #c4c9d1;
  font-size: 32rpx;
  font-weight: 400;
}
.drawer-desc {
  font-size: 28rpx;
  color: #4e5969;
  height: 64rpx;
  line-height: 64rpx;
  margin-top: 12rpx;
  padding: 0;
  border-bottom: 1rpx solid #f5f6f8;
}
.drawer-placeholder--sub {
  color: #c4c9d1;
  font-size: 28rpx;
}

.drawer-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 32rpx;
  gap: 16rpx;
}
.drawer-seg {
  display: inline-flex;
  background: #f0f1f3;
  border-radius: 12rpx;
  padding: 4rpx;
}
.drawer-seg-item {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #6b7280;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}
.drawer-seg-item--active.drawer-seg-item--low {
  background: #9aa3af;
  color: #ffffff;
}
.drawer-seg-item--active.drawer-seg-item--normal {
  background: #2f6fed;
  color: #ffffff;
}
.drawer-seg-item--active.drawer-seg-item--high {
  background: #e5484d;
  color: #ffffff;
}

.drawer-picker {
  display: inline-flex;
  align-items: center;
  background: #f5f6f8;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  transition: all 0.2s ease;
}
.drawer-picker--active {
  background: #e7efff;
  color: #2f6fed;
  font-weight: 500;
}
.picker-clear {
  margin-left: 10rpx;
  font-size: 28rpx;
  line-height: 1;
  color: #9aa3af;
}

.drawer-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  height: 88rpx;
  line-height: 1;
  padding: 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
  background: #2f6fed;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(47, 111, 237, 0.28);
  transition: opacity 0.2s, transform 0.1s;
}
.drawer-submit-btn::after {
  border: none;
}
.drawer-submit-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}
