/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
}

/* 统计卡片 */
.stat-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #1f2329;
}
.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa3af;
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef0f2;
}

/* 过滤 Tab */
.filter-bar {
  display: flex;
  margin: 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}
.filter-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6b7280;
  height: 64rpx;
  line-height: 1;
  padding: 0;
  border-radius: 12rpx;
  transition: background 0.2s;
}
.filter-tab--active {
  background: #2f6fed;
  color: #ffffff;
  font-weight: 500;
}

/* 列表与滑动单元格 */
.list {}
.swipe-cell {
  position: relative;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: #f1f3f6;
}

/* 左滑操作抽屉 */
.swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 280rpx;
  display: flex;
  align-items: stretch;
  z-index: 1;
}

.swipe-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  transition: opacity 0.15s;
}
.swipe-btn:active {
  opacity: 0.85;
}

.swipe-btn--complete {
  background: #10b981;
}
.swipe-btn--revert {
  background: #3b82f6;
}
.swipe-btn--delete {
  background: #ef4444;
}

.swipe-btn-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 6rpx;
}
.swipe-btn-icon--complete::after {
  content: '';
  position: absolute;
  top: 40%;
  left: 50%;
  width: 10rpx;
  height: 20rpx;
  border-bottom: 4rpx solid #ffffff;
  border-right: 4rpx solid #ffffff;
  transform: translate(-50%, -50%) rotate(45deg);
}
.swipe-btn-icon--delete::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 2rpx;
}
.swipe-btn-icon--delete::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 20rpx;
  border: 3.5rpx solid #ffffff;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.swipe-btn-text {
  font-size: 24rpx;
  line-height: 1;
}

/* 卡片上层内容主体 */
.todo-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  padding: 28rpx 24rpx;
  margin-bottom: 0;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform;
}
.todo-card--swiped {
  transform: translateX(-280rpx);
}
.check-hitbox {
  margin: -16rpx 14rpx -16rpx -16rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.check {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  border: 2.5rpx solid #c8cdd4;
  background: #fbfcfd;
  box-sizing: border-box;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
/* 未完成状态下展示极浅线稿勾勾作为意会提示 */
.check::after {
  content: '';
  position: absolute;
  top: 42%;
  left: 50%;
  width: 12rpx;
  height: 22rpx;
  border-bottom: 3.5rpx solid #a4acb9;
  border-right: 3.5rpx solid #a4acb9;
  transform: translate(-50%, -50%) rotate(45deg);
  opacity: 0.28;
  transition: all 0.18s ease;
}
.check--done {
  background: #2f6fed;
  border-color: #2f6fed;
  animation: check-bounce 0.24s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.check--done::after {
  border-bottom-color: #ffffff;
  border-right-color: #ffffff;
  opacity: 1;
  transform: translate(-50%, -50%) rotate(45deg) scale(1.05);
}
@keyframes check-bounce {
  0% { transform: scale(0.82); }
  50% { transform: scale(1.16); }
  100% { transform: scale(1); }
}
.todo-body {
  flex: 1;
  min-width: 0;
}
.todo-title {
  font-size: 30rpx;
  color: #1f2329;
  word-break: break-all;
}
.todo-title--done {
  color: #9aa3af;
  text-decoration: line-through;
}
.todo-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  line-height: 1;
  box-sizing: border-box;
}
.due-pill {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
  transition: all 0.2s ease;
}
.due-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.due-text {
  line-height: 1;
}
.due-pill--overdue {
  font-weight: 600;
  box-shadow: 0 0 0 1rpx rgba(229, 72, 77, 0.18) inset;
}
.due-pill--today {
  font-weight: 600;
  box-shadow: 0 0 0 1rpx rgba(224, 62, 26, 0.18) inset;
}
.due-pill--tomorrow {
  font-weight: 500;
}
.due-pill--completed {
  opacity: 0.75;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx dashed #c8cdd4;
  position: relative;
}
.empty-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 48rpx;
  height: 2rpx;
  background: #c8cdd4;
  transform: translate(-50%, -50%);
}
.empty-title {
  margin-top: 32rpx;
  font-size: 32rpx;
  color: #6b7280;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9aa3af;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2f6fed;
  box-shadow: 0 8rpx 24rpx rgba(47, 111, 237, 0.36);
  z-index: 90;
  transition: transform 0.15s, opacity 0.15s;
}
.fab:active {
  transform: scale(0.95);
}
.fab::before,
.fab::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  background: #ffffff;
  border-radius: 4rpx;
  transform: translate(-50%, -50%);
}
.fab::before {
  width: 40rpx;
  height: 5rpx;
}
.fab::after {
  width: 5rpx;
  height: 40rpx;
}

/* 快速新增半屏模态框（Bottom Sheet） */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(4px);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.26s cubic-bezier(0.16, 1, 0.3, 1);
}
.drawer-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.12);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  box-sizing: border-box;
  padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow: hidden; /* 坚决无滚动 */
}
.drawer--show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.drawer-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.drawer-status-pill {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #f4f6f8;
  border: 1rpx solid #e1e4e8;
  font-size: 24rpx;
  color: #4e5969;
  font-weight: 500;
  transition: all 0.2s ease;
}
.drawer-status-pill:active {
  transform: scale(0.96);
}
.drawer-status-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 2rpx solid #86909c;
  margin-right: 10rpx;
  box-sizing: border-box;
}
.drawer-status-pill--done {
  background: #eef8f1;
  border-color: #b7ebc7;
  color: #198754;
}
.drawer-status-pill--done .drawer-status-icon {
  border-color: #198754;
  background: #198754;
}
.drawer-status-pill--done .drawer-status-icon::after {
  content: '';
  position: absolute;
  top: 42%;
  left: 50%;
  width: 6rpx;
  height: 11rpx;
  border-bottom: 2.5rpx solid #ffffff;
  border-right: 2.5rpx solid #ffffff;
  transform: translate(-50%, -50%) rotate(45deg);
}
.drawer-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  letter-spacing: 0.5rpx;
}
.drawer-close {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f6f8;
  transition: background 0.15s;
}
.drawer-close::before,
.drawer-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 3rpx;
  background: #8c939f;
  border-radius: 2rpx;
}
.drawer-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}
.drawer-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.drawer-body {
  display: flex;
  flex-direction: column;
}
.drawer-input {
  font-size: 34rpx;
  font-weight: 500;
  color: #1f2329;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-bottom: 2rpx solid #f0f1f3;
}
.drawer-placeholder {
  color: #c4c9d1;
  font-size: 32rpx;
  font-weight: 400;
}
.drawer-desc {
  font-size: 28rpx;
  color: #4e5969;
  height: 64rpx;
  line-height: 64rpx;
  margin-top: 12rpx;
  padding: 0;
  border-bottom: 1rpx solid #f5f6f8;
}
.drawer-placeholder--sub {
  color: #c4c9d1;
  font-size: 28rpx;
}

.drawer-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 32rpx;
  gap: 16rpx;
}
.drawer-seg {
  display: inline-flex;
  background: #f0f1f3;
  border-radius: 14rpx;
  padding: 6rpx;
}
.drawer-seg-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}
.drawer-seg-item--active.drawer-seg-item--low {
  background: #9aa3af;
  color: #ffffff;
}
.drawer-seg-item--active.drawer-seg-item--normal {
  background: #2f6fed;
  color: #ffffff;
}
.drawer-seg-item--active.drawer-seg-item--high {
  background: #e5484d;
  color: #ffffff;
}
.drawer-picker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  height: 68rpx;
  background: #f7f8fa;
  border: 1rpx solid #e5e8ec;
  padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #4e5969;
  transition: all 0.2s ease;
}
.drawer-picker--active {
  background: #eef4ff;
  border-color: #b8d3fe;
  color: #2f6fed;
  font-weight: 500;
}
.picker-cal-icon {
  width: 26rpx;
  height: 24rpx;
  border: 2.5rpx solid currentColor;
  border-radius: 4rpx;
  margin-right: 12rpx;
  position: relative;
  flex: none;
}
.picker-cal-icon::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: currentColor;
}
.picker-label {
  line-height: 1;
}
.picker-clear {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #cfd4dc;
  margin-left: 14rpx;
  flex: none;
}
.picker-clear::before,
.picker-clear::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 2.5rpx;
  background-color: #ffffff;
  border-radius: 2rpx;
}
.picker-clear::before {
  transform: translate(-50%, -50%) rotate(45deg);
}
.picker-clear::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}
.drawer-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}
.drawer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 1;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.15s, transform 0.1s;
}
.drawer-btn::after {
  border: none;
}
.drawer-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}
.drawer-btn--full {
  flex: 1;
  width: 100% !important;
}
.drawer-btn--danger {
  flex: 1;
  background: #fff0f0;
  color: #e5484d;
  border: 1rpx solid #fed7da;
}
.drawer-btn--primary {
  flex: 2;
  background: #2f6fed;
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(47, 111, 237, 0.28);
}
