<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 统计卡片 -->
  <view class="stat-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.total}}</text>
      <text class="stat-label">全部</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.active}}</text>
      <text class="stat-label">进行中</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.completed}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <!-- 过滤 Tab -->
  <view class="filter-bar">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter-tab {{activeFilter === item.key ? 'filter-tab--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSwitchFilter"
    >{{item.label}}</view>
  </view>

  <!-- 列表 -->
  <view class="list" wx:if="{{list.length > 0}}">
    <view
      class="todo-card"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      data-title="{{item.title}}"
      bindtap="goEdit"
      bindlongpress="onLongPressDelete"
    >
      <view
        class="check {{item.completed ? 'check--done' : ''}}"
        catchtap="onToggle"
        data-id="{{item._id}}"
      >
        <text wx:if="{{item.completed}}" class="check-mark">✓</text>
      </view>
      <view class="todo-body">
        <view class="todo-title {{item.completed ? 'todo-title--done' : ''}}">{{item.title}}</view>
        <view class="todo-meta">
          <text class="tag" style="color: {{item.priorityColor}}; background: {{item.priorityBg}};">{{item.priorityLabel}}</text>
          <text wx:if="{{item.dueDate}}" class="due {{item.completed ? '' : 'due--warn'}}">截止 {{item.dueDate}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <view class="empty-icon"></view>
    <view class="empty-title">暂无待办</view>
    <view class="empty-sub">点击右下角按钮，添加第一条待办</view>
  </view>

  <!-- 悬浮新增按钮 -->
  <view class="fab" bindtap="goCreate">+</view>
</view>
