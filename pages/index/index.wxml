<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 统计卡片 -->
  <view class="stat-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.total}}</text>
      <text class="stat-label">全部</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.active}}</text>
      <text class="stat-label">进行中</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.completed}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <!-- 过滤 Tab -->
  <view class="filter-bar">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter-tab {{activeFilter === item.key ? 'filter-tab--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSwitchFilter"
    >{{item.label}}</view>
  </view>

  <!-- 列表 -->
  <view class="list" wx:if="{{list.length > 0}}">
    <view
      class="todo-card"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      data-title="{{item.title}}"
      bindtap="goEdit"
      bindlongpress="onLongPressDelete"
    >
      <view
        class="check-hitbox"
        catchtap="onToggle"
        data-id="{{item._id}}"
      >
        <view class="check {{item.completed ? 'check--done' : ''}}"></view>
      </view>
      <view class="todo-body">
        <view class="todo-title {{item.completed ? 'todo-title--done' : ''}}">{{item.title}}</view>
        <view class="todo-meta">
          <text class="tag" style="color: {{item.priorityColor}}; background: {{item.priorityBg}};">{{item.priorityLabel}}</text>
          <view
            wx:if="{{item.dueDate && item.dueMeta}}"
            class="due-pill due-pill--{{item.dueMeta.type}}"
            style="color: {{item.dueMeta.color}}; background: {{item.dueMeta.bg}};"
          >
            <view class="due-dot" style="background: {{item.dueMeta.color}};"></view>
            <text class="due-text">{{item.dueMeta.label}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <view class="empty-icon"></view>
    <view class="empty-title">暂无待办</view>
    <view class="empty-sub">点击右下角按钮，添加第一条待办</view>
  </view>

  <!-- 悬浮新增按钮 -->
  <view class="fab" bindtap="openCreateDrawer"></view>

  <!-- 快速新增半屏模态框（Bottom Sheet） -->
  <view
    class="drawer-mask {{showCreateDrawer ? 'drawer-mask--show' : ''}}"
    bindtap="closeCreateDrawer"
    catchtouchmove="noop"
  ></view>
  <view
    class="drawer {{showCreateDrawer ? 'drawer--show' : ''}}"
    catchtouchmove="noop"
  >
    <view class="drawer-header">
      <view class="drawer-header-left">
        <text class="drawer-title">{{isDrawerEdit ? '编辑待办' : '新增待办'}}</text>
        <view
          wx:if="{{isDrawerEdit}}"
          class="drawer-status-pill {{editCompleted ? 'drawer-status-pill--done' : ''}}"
          catchtap="onToggleDrawerComplete"
        >
          <view class="drawer-status-icon"></view>
          <text class="drawer-status-text">{{editCompleted ? '已完成' : '标记完成'}}</text>
        </view>
      </view>
      <view class="drawer-close" bindtap="closeCreateDrawer"></view>
    </view>

    <view class="drawer-body">
      <input
        class="drawer-input"
        placeholder="准备做什么？"
        placeholder-class="drawer-placeholder"
        value="{{newTitle}}"
        focus="{{inputFocus}}"
        maxlength="60"
        bindinput="onNewTitleInput"
        confirm-type="done"
        bindconfirm="onSaveCreate"
      />

      <input
        class="drawer-desc"
        placeholder="补充说明（可选）"
        placeholder-class="drawer-placeholder--sub"
        value="{{newDesc}}"
        maxlength="500"
        bindinput="onNewDescInput"
      />

      <view class="drawer-tools">
        <view class="drawer-seg">
          <view
            wx:for="{{priorities}}"
            wx:key="*this"
            class="drawer-seg-item drawer-seg-item--{{item}} {{newPriority === item ? 'drawer-seg-item--active' : ''}}"
            data-priority="{{item}}"
            data-index="{{index}}"
            bindtap="onNewPriorityTap"
          >{{priorityLabels[item]}}</view>
        </view>

        <picker mode="date" value="{{newDueDate}}" bindchange="onNewDateChange">
          <view class="drawer-picker {{newDueDate ? 'drawer-picker--active' : ''}}">
            <view class="picker-cal-icon"></view>
            <text class="picker-label">{{newDueDate ? newDueDate : '截止日期'}}</text>
            <view wx:if="{{newDueDate}}" class="picker-clear" catchtap="onClearNewDueDate"></view>
          </view>
        </picker>
      </view>

      <view class="drawer-actions">
        <button
          wx:if="{{isDrawerEdit}}"
          class="drawer-btn drawer-btn--danger"
          bindtap="onDrawerDelete"
        >删除</button>
        <button
          class="drawer-btn drawer-btn--primary {{isDrawerEdit ? '' : 'drawer-btn--full'}}"
          loading="{{creating}}"
          disabled="{{creating}}"
          bindtap="onSaveCreate"
        >{{isDrawerEdit ? '保存修改' : '保存待办'}}</button>
      </view>
    </view>
  </view>
</view>
